# Estado local gerado em execução (perfil, identidade e caches de conteúdo).
# Nunca deve acompanhar o repositório nem ser usado como dado de distribuição.
ArcaneArena/

# Unity Performance Test Framework generates these transient Resources assets
Assets/Resources/PerformanceTestRunInfo.json
Assets/Resources/PerformanceTestRunInfo.json.meta
Assets/Resources/PerformanceTestRunSettings.json
Assets/Resources/PerformanceTestRunSettings.json.meta

# IDE and tooling
.vs/
.vscode/
.idea/
.wrangler/
.release-secrets/
ExportedObj/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash and temporary files
sysinfo.txt
*.tmp
*.bak
*.orig
*.pid

# Builds and native artifacts are produced by documented scripts
Assets/Plugins/Windows/x86_64/*.dll
Assets/Plugins/Windows/x86_64/*.pdb
!Assets/Plugins/Windows/x86_64/ocgcore.dll
!Assets/Plugins/Android/arm64-v8a/libocgcore.so

# Copyrighted card art is staged locally and tracked through a hash manifest
ContentStaging/**/Art/
ContentStaging/**/Raw/
ContentStaging/production/artifacts/

# Reproducible project build scripts are source files
!Tools/Build/
!Tools/Build/**
